PORT=3000
DB_PATH=./data/ride2view.sqlite
# Set these only for the first administrator account. Never commit real credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Enable only behind HTTPS in production.
COOKIE_SECURE=false

# V9 production provider boundary. Keep real secrets in the hosting platform secret store.
# Gateway capabilities: payments,refunds,messaging,fiscal
R2V_GATEWAY_URL=
R2V_GATEWAY_TOKEN=
R2V_GATEWAY_CAPABILITIES=
# Required when payments are enabled; minimum 32 characters.
R2V_GATEWAY_CALLBACK_SECRET=
# Google Routes + Geocoding server-side key. Restrict the key to the required APIs.
GOOGLE_ROUTES_API_KEY=
# Optional HTTPS monitoring/webhook receiver for deployment health events.
R2V_MONITOR_URL=
R2V_MONITOR_TOKEN=
# External video, object storage, registry and native provider credentials are intentionally
# not accepted by the application until a reviewed adapter exists. Never expose them client-side.
